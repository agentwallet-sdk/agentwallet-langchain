{
  "name": "agentwallet-langchain",
  "version": "1.0.0",
  "description": "Non-custodial wallet toolkit for LangChain agents \u2014 EVM + Solana, spend limits, x402 payments, CCTP bridge",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --skipLibCheck --noCheck",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "langchain",
    "langgraph",
    "wallet",
    "agent",
    "evm",
    "solana",
    "x402",
    "cctp",
    "non-custodial",
    "structured-tool",
    "toolkit"
  ],
  "author": "Bill Wilson <bill@ai-agent-economy.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentwallet-sdk/agentwallet-langchain"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.2.0",
    "agentwallet-sdk": "^3.0.0"
  },
  "devDependencies": {
    "@langchain/core": "^0.3.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "agentwallet-sdk": "^3.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0",
    "zod": "^3.22.0"
  },
  "dependencies": {
    "zod": "^3.22.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", { "diagnostics": false, "isolatedModules": true }]
    },
    "moduleNameMapper": {
      "^agentwallet-sdk$": "<rootDir>/__mocks__/agentwallet-sdk.ts",
      "^viem$": "<rootDir>/__mocks__/viem.ts",
      "^viem/accounts$": "<rootDir>/__mocks__/viem-accounts.ts",
      "viem/chains": "<rootDir>/__mocks__/viem/chains.ts"
    }
  }
}
